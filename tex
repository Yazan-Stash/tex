#!/usr/bin/env bash

set -euo pipefail

directory="$(pwd -P)"
directory_name="$(basename -- "$directory")"
session="${directory_name//[^[:alnum:]_-]/_}"
texrc="$directory/.texrc"

if ! command -v tmux >/dev/null 2>&1; then
    echo "tex: tmux is required." >&2
    exit 1
fi

case "${1:-}" in
    stop)
        if tmux kill-session -t "$session" 2>/dev/null; then
            echo "Session '$session' stopped."
        else
            echo "No session '$session' running."
        fi

        exit 0
        ;;
    "")
        ;;
    *)
        echo "Usage: tex [stop]" >&2
        exit 1
        ;;
esac

if tmux has-session -t "$session" 2>/dev/null; then
    echo "Attaching to existing session '$session'..."
    exec tmux attach-session -t "$session"
fi

# Windows to create, in order. An empty command leaves an interactive shell.
window_names=()
window_commands=()

add_window() {
    window_names+=("$1")
    window_commands+=("$2")
}

trim() {
    local value="$1"

    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    printf '%s' "$value"
}

texrc_error() {
    echo "tex: .texrc:$1: $2" >&2
    exit 1
}

if [[ -e "$texrc" ]]; then
    if [[ ! -f "$texrc" || ! -r "$texrc" ]]; then
        echo "tex: cannot read .texrc" >&2
        exit 1
    fi

    line_number=0

    while IFS= read -r line || [[ -n "$line" ]]; do
        line_number=$((line_number + 1))
        line="$(trim "${line%$'\r'}")"

        if [[ -z "$line" || "$line" == \#* ]]; then
            continue
        fi

        if [[ "$line" != *:* ]]; then
            texrc_error "$line_number" "expected 'name: command'"
        fi

        name="$(trim "${line%%:*}")"
        command="$(trim "${line#*:}")"

        if [[ -z "$name" ]]; then
            texrc_error "$line_number" "window name is empty"
        fi

        for ((index = 0; index < ${#window_names[@]}; index++)); do
            if [[ "${window_names[index]}" == "$name" ]]; then
                texrc_error "$line_number" "duplicate window '$name'"
            fi
        done

        add_window "$name" "$command"
    done < "$texrc"

    if [[ ${#window_names[@]} -eq 0 ]]; then
        echo "tex: .texrc defines no windows" >&2
        exit 1
    fi
else
    required_commands=(vim opencode)
    is_git_repository=false
    is_laravel_project=false
    has_pail=false
    has_horizon=false
    package_script=""

    if command -v git >/dev/null 2>&1 && git -C "$directory" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        is_git_repository=true
        required_commands+=(lazygit)
    fi

    if [[ -f "$directory/package.json" ]]; then
        required_commands+=(node)

        if command -v node >/dev/null 2>&1; then
            if ! package_script="$(node -e 'const scripts = require(process.argv[1]).scripts ?? {}; if (Object.prototype.hasOwnProperty.call(scripts, "watch")) process.stdout.write("watch"); else if (Object.prototype.hasOwnProperty.call(scripts, "dev")) process.stdout.write("dev");' "$directory/package.json")"; then
                echo "tex: unable to parse package.json." >&2
                exit 1
            fi

            if [[ -n "$package_script" ]]; then
                required_commands+=(npm)
            fi
        fi
    fi

    composer_has_package() {
        local package="$1"

        php -r '$composer = json_decode(file_get_contents($argv[1]), true); exit(isset($composer["require"][$argv[2]]) || isset($composer["require-dev"][$argv[2]]) ? 0 : 1);' "$directory/composer.json" "$package"
    }

    if [[ -f "$directory/artisan" ]]; then
        is_laravel_project=true
        required_commands+=(php)

        if command -v php >/dev/null 2>&1 && [[ -f "$directory/composer.json" ]] && composer_has_package "laravel/pail"; then
            has_pail=true
        else
            required_commands+=(tail)
        fi

        if command -v php >/dev/null 2>&1 && [[ -f "$directory/composer.json" ]] && composer_has_package "laravel/horizon"; then
            has_horizon=true
        fi
    fi

    for command_name in "${required_commands[@]}"; do
        if ! command -v "$command_name" >/dev/null 2>&1; then
            echo "tex: $command_name is required." >&2
            exit 1
        fi
    done

    add_window "editor" "vim ."
    add_window "opencode" "opencode"
    add_window "terminal" ""

    if [[ "$is_git_repository" == true ]]; then
        add_window "lazygit" "lazygit"
    fi

    if [[ -n "$package_script" ]]; then
        add_window "$package_script" "npm run $package_script"
    fi

    if [[ "$is_laravel_project" == true ]]; then
        if [[ "$has_pail" == true ]]; then
            add_window "logs" "php artisan pail"
        else
            add_window "logs" "tail -f storage/logs/laravel.log"
        fi

        if [[ "$has_horizon" == true ]]; then
            add_window "horizon" "php artisan horizon"
        fi
    fi
fi

session_created=false

cleanup_session() {
    if [[ "$session_created" == true ]]; then
        tmux kill-session -t "$session" 2>/dev/null || true
    fi
}

trap cleanup_session ERR

# Windows are targeted by tmux IDs so names may contain spaces, dots, or colons.
session_info="$(tmux new-session -d -P -F '#{session_id} #{window_id}' -s "$session" -n "${window_names[0]}" -c "$directory")"
session_created=true
session_id="${session_info%% *}"
first_window_id="${session_info##* }"

for ((index = 0; index < ${#window_names[@]}; index++)); do
    if [[ "$index" -eq 0 ]]; then
        window_id="$first_window_id"
    else
        window_id="$(tmux new-window -d -P -F '#{window_id}' -t "$session_id:" -n "${window_names[index]}" -c "$directory")"
    fi

    if [[ -n "${window_commands[index]}" ]]; then
        tmux send-keys -t "$window_id" -l "${window_commands[index]}"
        tmux send-keys -t "$window_id" Enter
    fi
done

tmux select-window -t "$first_window_id"
session_created=false

exec tmux attach-session -t "$session"
